# ===================================
# VELODESK ENVIRONMENT VARIABLES
# Copy this to .env.local and fill in your values
# ===================================

# Supabase (Required)
# Get from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ===================================
# PAYMENTS
# ===================================

# Stripe (Required for international payments)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_xxx

# Paystack (Optional - for Nigeria)
# Get from: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
NEXT_PUBLIC_PAYSTACK_PRO_PLAN_CODE=PLN_xxx

# ===================================
# INTEGRATIONS (Optional)
# ===================================

# HubSpot
# Get from: https://developers.hubspot.com/
HUBSPOT_ACCESS_TOKEN=pat-xxx
NEXT_PUBLIC_HUBSPOT_CLIENT_ID=xxx

# Google Analytics
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# Stripe Connect (for integration)
NEXT_PUBLIC_STRIPE_CLIENT_ID=ca_xxx

# Intercom
NEXT_PUBLIC_INTERCOM_CLIENT_ID=xxx

# ===================================
# APP CONFIG
# ===================================

# App URL (change for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===================================
# AI (Optional - for AI features)
# ===================================

# Google Gemini (recommended)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# OR OpenAI (alternative)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# ===================================
# EMAIL (Optional - for notifications)
# ===================================

# Resend
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxx

# ===================================
# INVOICES & RECEIPTS (src/lib/invoices, src/lib/mailer.ts)
# ===================================
# Receipts are sent FROM billing@crelligent.com. Create that mailbox in cPanel and log in
# to SMTP as it (cPanel rejects a From address that isn't the logged-in mailbox).
SMTP_HOST=da34.host-ww.net
SMTP_PORT=587
SMTP_USER=billing@crelligent.com
SMTP_PASS=billing_mailbox_password
BILLING_FROM=billing@crelligent.com
BILLING_FROM_NAME=Velodesk by Crelligent
# Replies and "questions about this charge?" go here (defaults to BILLING_FROM)
BILLING_SUPPORT_EMAIL=billing@crelligent.com

# Seller details printed on every invoice (use \n for line breaks in the address)
BILLING_COMPANY_NAME=Crelligent & Company Ltd
BILLING_COMPANY_ADDRESS=Your street\nLagos, Nigeria
# RC number and TIN are built in (RC 9385150, TIN 2622487073685); set these only to override.
BILLING_RC_NUMBER=
BILLING_TIN=
# true = show VAT on NGN invoices. Prices are VAT-inclusive, so VAT is backed out of the
# amount charged. Leave false until your accountant confirms Crelligent should charge VAT.
BILLING_VAT_ENABLED=false
BILLING_VAT_RATE=7.5

# Protects POST /api/billing/invoices/test (sends a sample receipt)
CRON_SECRET=a_long_random_string
